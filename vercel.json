{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/api/:path((?!handler$).*)", "destination": "/api/handler?__p=:path" }],
  "functions": {
    "api/handler.mjs": { "maxDuration": 300, "memory": 1024, "includeFiles": "deploy-data/**" }
  }
}
