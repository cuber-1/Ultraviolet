{
  "name": "land-intelligence",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "ml:download": "machine-learning/.venv/bin/python machine-learning/download_ecocrop.py",
    "ml:download:observed": "PYTHONPATH=machine-learning machine-learning/.venv/bin/python -m cropfit.download_observed_validation",
    "ml:download:observed:national": "PYTHONPATH=machine-learning machine-learning/.venv/bin/python -m cropfit.download_national_validation",
    "ml:evaluate:observed": "PYTHONPATH=machine-learning machine-learning/.venv/bin/python -m cropfit.observed_validation",
    "ml:evaluate:observed:national": "PYTHONPATH=machine-learning machine-learning/.venv/bin/python -m cropfit.national_observed_validation",
    "ml:evaluate:features": "PYTHONPATH=machine-learning machine-learning/.venv/bin/python -m cropfit.feature_validation",
    "ml:build:yield-atlas": "PYTHONPATH=machine-learning machine-learning/.venv/bin/python -m cropfit.yield_atlas",
    "ml:evaluate:ranking": "PYTHONPATH=machine-learning machine-learning/.venv/bin/python -m cropfit.ranking_validation",
    "ml:train": "PYTHONPATH=machine-learning machine-learning/.venv/bin/python -m cropfit.training",
    "ml:serve": "PYTHONPATH=machine-learning machine-learning/.venv/bin/python -m uvicorn cropfit.trained_api:app --host 0.0.0.0 --port 8100",
    "ml:serve:demo": "PYTHONPATH=machine-learning machine-learning/.venv/bin/python -m uvicorn cropfit.api:app --host 127.0.0.1 --port 8100",
    "test:ml-failover": "node --experimental-strip-types scripts/verifyMlFailover.ts",
    "test:rural-ranking": "node --experimental-strip-types scripts/verifyRuralRanking.ts",
    "test:cropfit": "PYTHONPATH=machine-learning machine-learning/.venv/bin/python -m cropfit.verify_inference",
    "test:simulation": "node --experimental-strip-types scripts/verifySunSimulation.ts",
    "hardware:bridge": "node hardware/bridge/serial-bridge.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.6.5",
    "@langchain/core": "^1.4.1",
    "@langchain/openai": "^1.8.4",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@types/three": "^0.187.0",
    "d3-geo": "^3.1.2",
    "deepagents": "^1.16.5",
    "langchain": "^1.6.6",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "three": "^0.187.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  }
}
